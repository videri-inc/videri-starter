# videri-probe (CORE-10294). See AGENTS.md for the full protocol.

# Backend API base URL (no trailing slash). Defaults to sandbox if unset.
VIDERI_API_BASE_URL=https://api.sandbox.videri.com

# Your Videri Portal username and password.
VIDERI_USERNAME=
VIDERI_PASSWORD=

# The full API key string, from Dashboard > API Keys. Never commit this.
VIDERI_API_KEY=

# One tenant code from your account's tenants claim (Profile tab of your
# dashboard). Not the whole array - one call per tenant for multi-tenant
# accounts.
VIDERI_TENANT=
